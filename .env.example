# Copy to .env and adjust if needed:
#   cp .env.example .env

# Docker Compose (Postgres / Redis)
POSTGRES_USER=payments-pg-user
POSTGRES_PASSWORD=payments-pg-password
POSTGRES_DB=payments
REDIS_PASSWORD=payments

# Wallet process (cmd/wallet) and migrations (SERVICE=wallet)
DATABASE_URL=postgres://payments-pg-user:payments-pg-password@localhost:5432/wallet?sslmode=disable

# Wallet logging (optional; defaults shown)
LOG_LEVEL=info
LOG_FORMAT=text

# Integration tests (go test / make test). Same DB is fine locally.
TEST_DATABASE_URL=postgres://payments-pg-user:payments-pg-password@localhost:5432/wallet?sslmode=disable
